<div class="panel">
    <div class="panel-heading">
        {l s='Update All 404 Urls' mod='prettyurls'}
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-sm-5">
                <p>{l s='Click on button to update all 404 urls to same new url at once' mod='prettyurls'} </p>
            </div>
            <div class="col-sm-7">
                <button class="btn btn-default" id="update-all-urls">{l s='Update All' mod='prettyurls'}</button>
            </div>
        </div>
    </div>
</div>